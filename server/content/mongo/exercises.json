  {
    "id": "mx-06",
    "title": "Shipped or pending in NA",
    "level": "easy",
    "topic": "operators",
    "kind": "find",
    "collection": "orders",
    "prompt": "Find orders in region `\"NA\"` whose status is either `shipped` or `pending`. Return `_id`, `status`, `region`.",
    "solution": {
