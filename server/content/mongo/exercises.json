        "_id": "SKU-BP1",
        "units": 8
      },
      {
        "_id": "SKU-HD1",
        "units": 7
      },
      {
        "_id": "SKU-NB1",
        "units": 6
      },
      {
        "_id": "SKU-PN1",
        "units": 6
      }
    ],
    "hints": [
      "`$unwind: \"$items\"` produces one document per line item.",
