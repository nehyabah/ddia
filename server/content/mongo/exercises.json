    "expected": [
      {
        "createdAt": "2026-10-02T08:00:00Z",
        "total": 89.99,
        "_id": "O1001"
      },
      {
        "createdAt": "2026-10-04T09:13:00Z",
        "total": 134.5,
        "_id": "O1002"
      },
      {
        "createdAt": "2026-10-06T10:26:00Z",
        "total": 118,
        "_id": "O1003"
      },
      {
        "createdAt": "2026-10-08T11:39:00Z",
        "total": 277.5,
        "_id": "O1004"
      },
      {
        "createdAt": "2026-10-12T13:05:00Z",
        "total": 45,
        "_id": "O1006"
      },
      {
        "createdAt": "2026-10-14T14:18:00Z",
        "total": 183.99,
        "_id": "O1007"
      },
      {
        "createdAt": "2026-10-16T15:31:00Z",
        "total": 189,
        "_id": "O1008"
      },
      {
        "createdAt": "2026-10-18T16:44:00Z",
        "total": 101.98,
        "_id": "O1009"
      },
      {
        "createdAt": "2026-10-20T17:57:00Z",
        "total": 115.5,
        "_id": "O1010"
      },
      {
        "createdAt": "2026-10-22T08:10:00Z",
        "total": 241.5,
        "_id": "O1011"
      }
    ],
    "hints": [
      "Use `$gte`/`$lt` on `createdAt` with string bounds.",
      "`$ne` excludes a value."
    ],
    "explanation": "ISO strings sort lexicographically in time order (real apps should store BSON Dates). Index `{ createdAt: 1 }` handles the range and the sort; `$ne` is not selective, so it makes a poor leading index field."
