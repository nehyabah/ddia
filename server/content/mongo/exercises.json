  {
    "id": "mx-19",
    "title": "Daily active users",
    "level": "medium",
    "topic": "aggregation",
    "kind": "aggregate",
    "collection": "events",
    "prompt": "From `events`, compute daily active users: the number of distinct `userId`s per calendar day (the first 10 characters of `ts`). Output `{ day, dau }` sorted by `day`.",
    "solution": [
      {
        "$group": {
          "_id": {
            "$substr": [
              "$ts",
              0,
              10
            ]
          },
          "users": {
            "$addToSet": "$userId"
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "day": "$_id",
          "dau": {
            "$size": "$users"
          }
        }
      },
      {
        "$sort": {
          "day": 1
        }
      }
    ],
    "orderMatters": true,
    "expected": [
      {
        "dau": 4,
        "day": "2026-11-10"
      },
      {
        "dau": 4,
        "day": "2026-11-11"
      },
      {
        "dau": 4,
        "day": "2026-11-12"
      },
      {
        "dau": 4,
        "day": "2026-11-13"
      },
      {
        "dau": 4,
        "day": "2026-11-14"
      },
      {
        "dau": 4,
        "day": "2026-11-15"
      },
      {
        "dau": 4,
        "day": "2026-11-16"
      }
    ],
    "hints": [
      "`$substr: [\"$ts\", 0, 10]` extracts the date.",
      "`$addToSet` collects distinct values; `$size` counts them."
    ],
    "explanation": "`$addToSet` deduplicates. At scale, group twice (by day+user, then by day) to avoid huge in-memory sets. Index `{ ts: 1 }` helps once you add a time-range `$match`."
  },
  {
    "id": "mx-20",
    "title": "Conversion funnel",
    "level": "hard",
    "topic": "group",
    "kind": "aggregate",
    "collection": "events",
    "prompt": "Compute a one-document funnel from `events`: counts of `page_view` (`views`), `add_to_cart` (`carts`) and `checkout` (`checkouts`), plus `checkoutRate = checkouts / views` rounded to 3 decimals. Output one document without `_id`.",
    "solution": [
      {
        "$group": {
          "_id": null,
          "views": {
            "$sum": {
              "$cond": [
                {
                  "$eq": [
                    "$type",
                    "page_view"
                  ]
                },
                1,
                0
              ]
            }
          },
          "carts": {
            "$sum": {
              "$cond": [
                {
                  "$eq": [
                    "$type",
                    "add_to_cart"
                  ]
                },
                1,
                0
              ]
            }
          },
          "checkouts": {
            "$sum": {
              "$cond": [
                {
                  "$eq": [
                    "$type",
                    "checkout"
                  ]
                },
                1,
                0
              ]
            }
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "views": 1,
          "carts": 1,
          "checkouts": 1,
          "checkoutRate": {
            "$round": [
              {
                "$divide": [
                  "$checkouts",
                  "$views"
                ]
              },
              3
            ]
          }
        }
      }
    ],
    "orderMatters": false,
    "expected": [
      {
        "carts": 4,
        "checkoutRate": 0.2,
        "checkouts": 3,
        "views": 15
      }
    ],
    "hints": [
      "`$group` with `_id: null` aggregates everything into one group.",
      "Conditional counting: `$sum: { $cond: [ { $eq: [\"$type\", \"page_view\"] }, 1, 0 ] }`."
    ],
    "explanation": "Conditional sums compute several metrics in a single pass, pivoting rows into columns."
  },
  {
    "id": "mx-21",
    "title": "Customer spend leaderboard",
    "level": "hard",
    "topic": "aggregation",
    "kind": "aggregate",
    "collection": "orders",
    "prompt": "For non-cancelled orders, group by `customerId`, computing `spend` (sum of `total`), `orders` (count) and `lastOrder` (latest `createdAt`). Keep only customers with at least 2 orders and return the top 3 by `spend` (ties by `_id`).",
    "solution": [
      {
        "$match": {
          "status": {
            "$ne": "cancelled"
          }
        }
      },
      {
        "$group": {
          "_id": "$customerId",
          "spend": {
            "$sum": "$total"
          },
          "orders": {
            "$sum": 1
          },
          "lastOrder": {
            "$max": "$createdAt"
          }
        }
      },
      {
        "$match": {
          "orders": {
            "$gte": 2
          }
        }
      },
      {
        "$sort": {
          "spend": -1,
          "_id": 1
        }
      },
      {
        "$limit": 3
      }
    ],
    "orderMatters": true,
    "expected": [
      {
        "_id": "C16",
        "spend": 926.99,
        "orders": 2,
        "lastOrder": "2026-11-13T12:12:00Z"
      },
      {
        "_id": "C09",
        "spend": 490.99,
        "orders": 2,
        "lastOrder": "2026-11-12T11:59:00Z"
      },
      {
        "_id": "C05",
        "spend": 490.5,
        "orders": 2,
        "lastOrder": "2026-11-09T08:20:00Z"
      }
    ],
    "hints": [
      "A second `$match` after `$group` acts like SQL HAVING.",
      "`$max` works on ISO strings."
    ],
    "explanation": "A `$match` after `$group` filters groups (HAVING). Only the leading `$match` can use an index."
  },
  {
    "id": "mx-22",
    "title": "Bucket orders by size",
    "level": "hard",
    "topic": "aggregation",
    "kind": "aggregate",
    "collection": "orders",
    "prompt": "Build a histogram of `orders` by `total` with buckets `[0,50)`, `[50,150)`, `[150,300)`, `[300,1000)` and a `\"1000+\"` default bucket. For each bucket output `count` and `avgTotal` (rounded to 2 decimals).",
    "solution": [
      {
        "$bucket": {
          "groupBy": "$total",
          "boundaries": [
            0,
            50,
            150,
            300,
            1000
          ],
          "default": "1000+",
          "output": {
            "count": {
              "$sum": 1
            },
            "avgTotal": {
              "$avg": "$total"
            }
          }
        }
      },
      {
        "$project": {
          "count": 1,
          "avgTotal": {
            "$round": [
              "$avgTotal",
              2
            ]
          }
        }
      }
    ],
    "orderMatters": true,
    "expected": [
      {
        "avgTotal": 27.37,
        "count": 4,
        "_id": 0
      },
      {
        "avgTotal": 112.94,
        "count": 9,
        "_id": 50
      },
      {
        "avgTotal": 224.94,
        "count": 9,
        "_id": 150
      },
      {
        "avgTotal": 488.65,
        "count": 3,
        "_id": 300
      }
    ],
    "hints": [
      "Use `$bucket` with `groupBy`, `boundaries`, `default` and `output`.",
      "Round in a following `$project`."
    ],
    "explanation": "`$bucket` groups by ranges and emits buckets in boundary order (empty buckets are omitted). `$bucketAuto` chooses boundaries for you."
  },
  {
    "id": "mx-23",
    "title": "The ESR rule",
    "level": "medium",
    "topic": "indexes",
    "kind": "choice",
    "prompt": "Query: `db.orders.find({ status: \"shipped\", region: \"EMEA\", total: { $gt: 100 } }).sort({ createdAt: -1 })`.\n\nFollowing the **Equality, Sort, Range** (ESR) guideline, which index prefix is the best start (before appending `total`)?",
    "options": [
      "{ createdAt: 1, status: 1, region: 1 }",
      "{ total: 1, status: 1, region: 1 }",
      "{ status: 1, region: 1, createdAt: 1 }",
      "{ region: 1, total: 1, createdAt: 1 }"
    ],
    "answer": 2,
    "hints": [
      "Equality fields first, then the sort field, then range fields."
    ],
    "explanation": "ESR: equality fields (`status`, `region`) first, then the sort key (`createdAt`) so results stream out already sorted, then range fields (`total`). Full index: `{ status: 1, region: 1, createdAt: -1, total: 1 }`."
  },
  {
    "id": "mx-24",
    "title": "Reading explain()",
    "level": "medium",
    "topic": "explain",
    "kind": "choice",
    "prompt": "Which `explain(\"executionStats\")` result most strongly suggests a **missing index**?",
    "options": [
      "IXSCAN with totalDocsExamined about equal to nReturned",
      "COLLSCAN with totalDocsExamined far larger than nReturned",
      "FETCH with totalKeysExamined equal to nReturned",
      "PROJECTION_COVERED with totalDocsExamined = 0"
    ],
    "answer": 1,
    "hints": [
      "Compare how many documents were examined with how many were returned."
    ],
    "explanation": "A COLLSCAN that examines far more documents than it returns reads everything to find a few matches. With a good index, keys and docs examined stay close to nReturned."
  },
  {
    "id": "mx-25",
    "title": "Covered query",
    "level": "medium",
    "topic": "indexes",
    "kind": "choice",
    "prompt": "With the index `{ email: 1, tier: 1 }` on `customers`, which query is **covered** (answered entirely from the index, `totalDocsExamined: 0`)?",
    "options": [
      "db.customers.find({ email: \"a@x.com\" })",
      "db.customers.find({ email: \"a@x.com\" }, { email: 1, tier: 1 })",
      "db.customers.find({ email: \"a@x.com\" }, { _id: 0, email: 1, tier: 1 })",
      "db.customers.find({ email: \"a@x.com\" }, { _id: 0, email: 1, name: 1 })"
    ],
    "answer": 2,
    "hints": [
      "Every filtered and returned field must be in the index.",
      "`_id` is returned by default."
    ],
    "explanation": "A covered query filters and returns only indexed fields. `_id` is not in this index, so it must be excluded; `name` is not indexed either, so option 4 needs a FETCH."
  },
  {
    "id": "mx-26",
    "title": "Multikey index limits",
    "level": "hard",
    "topic": "indexes",
    "kind": "choice",
    "prompt": "Which compound index **cannot be built** in MongoDB?",
    "options": [
      "{ tags: 1, name: 1 } on customers",
      "{ \"items.sku\": 1, status: 1 } on orders",
      "{ tags: 1, \"address.city\": 1 } on customers",
      "{ tags: 1, ratings: 1 } where both fields are arrays in the same documents"
    ],
    "answer": 3,
    "hints": [
      "Count the index entries a document would produce when two indexed fields are arrays."
    ],
    "explanation": "A compound multikey index allows at most one array-valued field per document. Indexing two parallel arrays would need the cartesian product of their elements, so MongoDB rejects it (\"cannot index parallel arrays\")."
  },
  {
    "id": "mx-27",
    "title": "Embed or reference?",
    "level": "medium",
    "topic": "schema",
    "kind": "choice",
    "prompt": "An e-commerce app shows the order page (an order and its line items) constantly, while a customer can accumulate thousands of orders over the years. Which schema is best?",
    "options": [
      "Embed all of a customer's orders inside the customer document",
      "Embed line items inside each order; reference the customer by customerId",
      "Put each line item in its own collection and reference everything",
      "Embed the full product document (description, stock, ratings) in every line item"
    ],
    "answer": 1,
    "hints": [
      "Embed what is read together and bounded; reference what grows without bound.",
      "Documents are limited to 16 MB."
    ],
    "explanation": "Line items are bounded and always read with their order, so embed them (snapshotting the price, as this dataset does). Orders per customer are unbounded, so reference them. Embedding mutable product data like stock forces you to update many documents."
  },
  {
    "id": "mx-28",
    "title": "Choosing a shard key",
    "level": "hard",
    "topic": "schema",
    "kind": "choice",
    "prompt": "`orders` is growing to billions of documents. Inserts are heavy and most reads are \"orders for customer X\". Which shard key is best?",
    "options": [
      "{ createdAt: 1 }",
      "{ status: 1 }",
      "{ customerId: \"hashed\" }",
      "{ _id: 1 } where _id is an ObjectId"
    ],
    "answer": 2,
    "hints": [
      "Avoid monotonically increasing keys (one hot chunk) and low-cardinality keys.",
      "Reads should target a single shard."
    ],
    "explanation": "A hashed `customerId` spreads writes evenly (high cardinality, not monotonic) and per-customer queries still go to one shard. `createdAt` and ObjectId increase monotonically, so all inserts hit one shard; `status` has too few values to split into chunks."
  }
]