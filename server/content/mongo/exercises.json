  {
    "id": "mx-13",
    "title": "Count orders per status",
    "level": "easy",
    "topic": "group",
    "kind": "aggregate",
    "collection": "orders",
    "prompt": "Using an aggregation pipeline on `orders`, count orders per `status`. Output `{ _id: <status>, count }`, sorted by `_id` ascending.",
    "solution": [
      {
        "$group": {
          "_id": "$status",
          "count": {
            "$sum": 1
          }
        }
      },
      {
        "$sort": {
          "_id": 1
        }
      }
    ],
    "orderMatters": true,
    "expected": [
      {
        "_id": "cancelled",
        "count": 3
      },
      {
        "_id": "delivered",
        "count": 11
      },
      {
        "_id": "pending",
        "count": 4
      },
      {
        "_id": "shipped",
        "count": 7
      }
    ],
    "hints": [
      "`$group` with `_id: \"$status\"`.",
      "`$sum: 1` counts documents."
    ],
    "explanation": "Classic group-and-count. `$group` must read every input document; an index on `{ status: 1 }` helps only once you add a `$match`, or for DISTINCT_SCAN-friendly shapes."
  },
  {
    "id": "mx-14",
    "title": "Revenue by region",
    "level": "medium",
    "topic": "aggregation",
    "kind": "aggregate",
    "collection": "orders",
    "prompt": "Compute revenue per `region`, counting only `delivered` and `shipped` orders. Output `{ _id: region, revenue, orders }` sorted by `revenue` descending.",
    "solution": [
      {
        "$match": {
          "status": {
            "$in": [
              "delivered",
              "shipped"
            ]
          }
        }
      },
      {
        "$group": {
          "_id": "$region",
          "revenue": {
            "$sum": "$total"
          },
          "orders": {
            "$sum": 1
          }
        }
      },
      {
        "$sort": {
          "revenue": -1
        }
      }
    ],
    "orderMatters": true,
    "expected": [
      {
        "_id": "NA",
        "revenue": 1023.48,
        "orders": 7
      },
      {
        "_id": "EMEA",
        "revenue": 965.47,
        "orders": 7
      },
      {
        "_id": "APAC",
        "revenue": 674.99,
        "orders": 4
      }
    ],
    "hints": [
      "`$match` first, then `$group`.",
      "`$sum: \"$total\"` adds up a field."
    ],
    "explanation": "Put `$match` first so it can use an index (`{ status: 1 }`) and shrink the data before `$group`."
  },
  {
    "id": "mx-15",
    "title": "Average rating per product",
    "level": "medium",
    "topic": "aggregation",
    "kind": "aggregate",
    "collection": "products",
    "prompt": "For products with at least one rating, compute `avgRating` (rounded to 2 decimals). Output `{ sku, avgRating }`: the top 5 by `avgRating` desc, then `sku` asc.",
    "solution": [
      {
        "$match": {
          "ratings.0": {
            "$exists": true
          }
        }
      },
      {
        "$project": {
          "_id": 0,
          "sku": 1,
          "avgRating": {
            "$round": [
              {
                "$avg": "$ratings"
              },
              2
            ]
          }
        }
      },
      {
        "$sort": {
          "avgRating": -1,
          "sku": 1
        }
      },
      {
        "$limit": 5
      }
    ],
    "orderMatters": true,
    "expected": [
      {
        "avgRating": 5,
        "sku": "SKU-CH1"
      },
      {
        "avgRating": 5,
        "sku": "SKU-DS1"
      },
      {
        "avgRating": 5,
        "sku": "SKU-HD1"
      },
      {
        "avgRating": 4.5,
        "sku": "SKU-MN1"
      },
      {
        "avgRating": 4.33,
        "sku": "SKU-MG1"
      }
    ],
    "hints": [
      "`\"ratings.0\": {$exists: true}` means the array is non-empty.",
      "`$avg` on an array inside `$project` averages its elements; wrap it in `$round`."
    ],
    "explanation": "Array expressions work inside `$project`. A second sort key breaks ties so the output is deterministic. For hot reads, precompute `avgRating` on write."
  },
  {
    "id": "mx-16",
    "title": "Units sold per SKU",
    "level": "medium",
    "topic": "unwind",
    "kind": "aggregate",
    "collection": "orders",
    "prompt": "Across non-cancelled orders, compute total units sold per SKU. Output `{ _id: sku, units }`: the top 5 by `units` desc, then `_id` asc.",
    "solution": [
      {
        "$match": {
          "status": {
            "$ne": "cancelled"
