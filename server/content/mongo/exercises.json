  {
    "id": "mx-17",
    "title": "Revenue per product category",
    "level": "hard",
    "topic": "lookup",
    "kind": "aggregate",
    "collection": "orders",
    "prompt": "Join order line items to `products` (on `items.sku` = `products.sku`) and compute revenue (`qty * price`) per product `category`, across all orders. Output `{ _id: category, revenue }` sorted by `revenue` desc.",
    "solution": [
      {
        "$unwind": "$items"
      },
      {
        "$lookup": {
          "from": "products",
          "localField": "items.sku",
          "foreignField": "sku",
          "as": "product"
        }
      },
      {
        "$unwind": "$product"
      },
      {
        "$group": {
          "_id": "$product.category",
          "revenue": {
            "$sum": {
              "$multiply": [
                "$items.qty",
                "$items.price"
              ]
            }
          }
        }
      },
      {
        "$sort": {
          "revenue": -1
        }
      }
    ],
    "orderMatters": true,
    "expected": [
      {
        "_id": "electronics",
        "revenue": 1629.46
      },
      {
        "_id": "furniture",
        "revenue": 1079
      },
      {
        "_id": "books",
        "revenue": 815.5
      },
      {
        "_id": "accessories",
        "revenue": 520
      },
      {
        "_id": "kitchen",
        "revenue": 419.94
      },
      {
        "_id": "stationery",
        "revenue": 152.5
      }
    ],
    "hints": [
      "`$unwind` the items first, then `$lookup` with `localField`/`foreignField`.",
      "`$lookup` outputs an array; `$unwind` it to get a single product.",
      "Put `$multiply` inside `$sum`."
    ],
    "explanation": "`$lookup` is a left outer join, run once per input document. In real MongoDB an index on `products.sku` is essential; otherwise every lookup scans the products collection."
  },
  {
