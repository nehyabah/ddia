      },
      {
        "region": "NA",
        "status": "shipped",
        "_id": "O1017"
      }
    ],
    "hints": [
      "`$in` takes an array of allowed values.",
      "Multiple top-level fields are ANDed."
    ],
    "explanation": "`$in` behaves like several equality matches. An index `{ region: 1, status: 1 }` answers it with a few tight index bounds."
  },
  {
    "id": "mx-07",
    "title": "Out of stock or unrated",
    "level": "medium",
    "topic": "operators",
    "kind": "find",
    "collection": "products",
    "prompt": "Find products that are out of stock (`stock` is 0) **or** have no ratings (empty `ratings` array). Return `sku`, `stock`, `ratings` without `_id`, sorted by `sku`.",
    "solution": {
      "filter": {
        "$or": [
          {
            "stock": 0
          },
          {
            "ratings": {
              "$size": 0
            }
          }
        ]
      },
      "projection": {
        "_id": 0,
        "sku": 1,
        "stock": 1,
        "ratings": 1
      },
      "sort": {
        "sku": 1
      },
      "limit": null
    },
    "orderMatters": true,
    "expected": [
      {
        "ratings": [
          5
        ],
        "sku": "SKU-HD1",
        "stock": 0
      },
      {
        "ratings": [
          2,
          5,
          5
        ],
        "sku": "SKU-HP1",
        "stock": 0
      },
      {
        "ratings": [
          5,
          2,
          2
        ],
        "sku": "SKU-KT1",
        "stock": 0
      },
      {
        "ratings": [],
        "sku": "SKU-PN1",
        "stock": 127
      }
    ],
    "hints": [
      "Use `$or` with an array of sub-filters.",
      "`$size: 0` matches empty arrays."
    ],
    "explanation": "`$or` can use a separate index per branch. `$size` cannot use an index; store a `ratingCount` field if this query is hot."
  },
