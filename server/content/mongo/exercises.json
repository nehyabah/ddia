  {
    "id": "mx-10",
    "title": "Same item: bulk and pricey",
    "level": "medium",
    "topic": "arrays",
    "kind": "find",
    "collection": "orders",
    "prompt": "Find orders where a **single** line item has `qty >= 2` **and** `price > 50`. Return `items` (keep `_id`), sorted by `_id`.\n\nCareful: `{\"items.qty\": {$gte: 2}, \"items.price\": {$gt: 50}}` could be satisfied by two *different* items.",
    "solution": {
      "filter": {
        "items": {
          "$elemMatch": {
            "qty": {
              "$gte": 2
            },
            "price": {
              "$gt": 50
            }
          }
        }
      },
      "projection": {
        "items": 1
      },
      "sort": {
        "_id": 1
      },
      "limit": null
    },
    "orderMatters": true,
    "expected": [
      {
        "items": [
          {
            "sku": "SKU-WC1",
            "qty": 2,
            "price": 59
          }
        ],
        "_id": "O1003"
      },
      {
        "items": [
          {
            "sku": "SKU-WC1",
            "qty": 1,
            "price": 59
          },
          {
            "sku": "SKU-BP1",
            "qty": 2,
            "price": 65
          }
        ],
        "_id": "O1008"
      },
      {
        "items": [
          {
            "sku": "SKU-KB1",
            "qty": 1,
            "price": 89.99
          },
          {
            "sku": "SKU-BP1",
            "qty": 2,
            "price": 65
          }
        ],
        "_id": "O1020"
      },
      {
        "items": [
          {
            "sku": "SKU-BP1",
            "qty": 3,
            "price": 65
          },
          {
            "sku": "SKU-PN1",
            "qty": 3,
            "price": 6
          }
        ],
        "_id": "O1021"
      }
    ],
    "hints": [
      "`$elemMatch` applies all conditions to the same array element."
    ],
    "explanation": "Without `$elemMatch`, each condition can be satisfied by a different element. A compound multikey index `{ \"items.qty\": 1, \"items.price\": 1 }` can be used; bounds are only combined tightly under `$elemMatch`."
  },
  {
    "id": "mx-11",
    "title": "Data quality: missing fields",
    "level": "medium",
    "topic": "operators",
    "kind": "find",
    "collection": "customers",
    "prompt": "Find customers that have **no** `address.city` field, **or** whose `email` is `null`. Return `name` (with `_id`), sorted by `_id`.",
    "solution": {
      "filter": {
        "$or": [
          {
            "address.city": {
              "$exists": false
            }
          },
          {
            "email": null
          }
        ]
      },
      "projection": {
        "name": 1
      },
      "sort": {
        "_id": 1
      },
      "limit": null
    },
    "orderMatters": true,
    "expected": [
      {
        "name": "Liam Wong",
        "_id": "C12"
      },
      {
        "name": "Quinn Lee",
        "_id": "C17"
      }
    ],
    "hints": [
      "`$exists: false` matches missing fields.",
      "`{ email: null }` matches null *or* missing."
    ],
    "explanation": "`{field: null}` matches both null and missing values; `$exists` distinguishes them. Sparse and partial indexes skip documents missing the field, so they cannot answer `$exists: false`."
  },
  {
    "id": "mx-12",
    "title": "October orders",
    "level": "medium",
    "topic": "operators",
    "kind": "find",
    "collection": "orders",
    "prompt": "Find non-cancelled orders created in October 2026. `createdAt` is an ISO-8601 string, so string range comparisons work. Return `createdAt` and `total` (with `_id`), oldest first.",
